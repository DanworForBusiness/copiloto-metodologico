# .env.example — Danwor Hub, versioned public config contract.
#
# This documents every variable config.py supports; it is NOT a checklist to
# copy in full into your own .env. Most lines already show config.py's own
# safe default (harmless to expose — it's already public in that file's
# source) purely for reference: you do not need to set them locally unless
# you're deliberately overriding that default. Lines with no default (blank
# after "=") represent genuinely optional capabilities or persistence
# credentials that are absent by design on a normal local checkout.
#
# Four classification tags, one per variable (see the comment above each key):
#   required for local Hub            -> core Hub/login genuinely needs this;
#                                         almost always has a safe, real
#                                         default already, so no action needed.
#   required in deployment            -> only matters once actually deployed
#                                         (DigitalOcean); safe local default.
#   optional capability                -> a specific feature/vertical; the Hub
#                                         runs fine without it, that feature
#                                         just shows CONFIG_INCOMPLETE or
#                                         degrades gracefully until set.
#   intentionally not configured in local dev
#                                       -> DigitalOcean Spaces persistence,
#                                         deliberately absent on every local
#                                         checkout.
#
# Never put a real secret VALUE on this file. Lines marked # SECRET must only
# ever hold a real value in your own untracked, gitignored .env.
#
# This file is discovered from config.py, not hand-duplicated: every key
# below exists because tools/config_audit.py's static AST scan of config.py
# found it. Verify this file never drifts from config.py with:
#   python tools/config_audit.py --env-file .env.example
# (that run should report zero UNUSED and zero REQUIRED_MISSING)

# =============================================================================
# Core Hub
# =============================================================================

# required for local Hub
ALLOWED_USERS=ALL
# required for local Hub
APP_OWNER=joconnor
# required for local Hub
AUTH_DEFAULT_DOMAIN=danwor.com
# required for local Hub
DANWOR_APP_TITLE=Copiloto Metodológico | Arquitecto Danwor
# required for local Hub
DANWOR_APP_SUBTITLE=SAP Datasphere · BDC-Ready · Inteligencia metodológica
# required for local Hub
DANWOR_LOGO_URL=https://certificaciones.greatplacetowork.com.ar/hubfs/Danwor%20LOGO.png
# required for local Hub
DANWOR_CONTENT_PACK=datasphere_core
# required for local Hub
DANWOR_DIAGNOSTIC_MODE=false
# required for local Hub
DANWOR_EXECUTION_MODE=API Real
# required for local Hub
DANWOR_IA_DISABLED_MODULES=00
# required for local Hub
DANWOR_SECTION_NUMBER_WIDTH=2
# required for local Hub
DANWOR_STATUS=DEV
# required for local Hub
DANWOR_TITLE_CONTEXT=ON
# required for local Hub
LOG_ACTIVITY=VERBOSE
# required for local Hub
OPENAI_MODEL=gpt-4o-mini
# required for local Hub
SESSION_MAX_AGE=28800
# required for local Hub. # SECRET -- the value below is the committed dev
# placeholder (already public in config.py's own source), never a real
# secret. Override with your own value ONLY in deployment.
SESSION_SECRET=danwor-copiloto-dev-secret-cambiar-en-produccion
# required for local Hub
SUPPORT_LINK_LENGTH=15

# optional capability (module-level IA gating override)
DANWOR_IA_ENABLED_MODULES=
# optional capability (read-only Danwor Academy tier)
ACADEMY_USERS=
# optional capability (Usage Metrics access, cross-vertical)
HUB_METRICS_ALLOWED_USERS=

# required in deployment (safe local default)
DESAFIO_CLOSE_URL=https://danwor.com.ar/copiloto/
# required in deployment (safe local default)
HUB_METRICS_ENABLED_VERTICALS=operations
# required in deployment (safe local default; only matters when iframed cross-origin)
SESSION_COOKIE_SAMESITE=lax
# required in deployment (safe local default; only matters when iframed cross-origin)
SESSION_COOKIE_SECURE=false

# =============================================================================
# Graph / Microsoft (core login)
# =============================================================================

# required for local Hub -- login itself needs Graph. Already has a real,
# working default for the Danwor tenant (client_id/tenant_id are public OAuth
# identifiers, not secrets); only override to point at a different
# tenant/app registration.
AZURE_CLIENT_ID=Ad98b5cd-71d0-451f-8d70-e8581a4788fa
# required for local Hub (same as above)
AZURE_TENANT_ID=f287b953-5428-4a5e-ae17-bd9c4cfaedbe

# =============================================================================
# Spaces persistence (DigitalOcean Spaces — durable backup/restore)
# =============================================================================
# App Platform runs on an ephemeral filesystem: everything the Hub writes
# (catalogs, case library, feedback, activity, Human Capital data, etc.) is
# lost on every deploy/recycle unless backed up here. If ANY of the four
# core credentials below is absent, persistence is a no-op — dev local is
# UNCHANGED, never broken. This is the intended, normal local state; do not
# provision these credentials into localhost.

# intentionally not configured in local dev
SPACES_ENDPOINT=
# intentionally not configured in local dev
SPACES_BUCKET=
# intentionally not configured in local dev. # SECRET
SPACES_KEY=
# intentionally not configured in local dev. # SECRET
SPACES_SECRET=
# intentionally not configured in local dev (optional environment separator)
SPACES_PREFIX=

# required in deployment (safe local default)
SPACES_REGION=atl1
# required in deployment (safe local default)
SPACES_SYNC_INTERVAL=120
# required in deployment (safe local default -- if you add a new persisted
# directory in config.py, add it to this default too)
SPACES_PERSIST_PATHS=catalog_local,case_library,feedback_log,activity_log,reports,reporting_cache,human-capital,commercial_strategy_runtime,commercial-licensing-priority,governed-assessments

# =============================================================================
# Human Capital
# =============================================================================
# All optional: the vertical boots fine without any of these, individual
# features (documents/CV upload, governed catalogs) show CONFIG_INCOMPLETE
# until configured.

# optional capability (workspace access gate)
HUMAN_CAPITAL_ALLOWED_USERS=
# optional capability (SharePoint identity shared by documents + catalog)
HC_SHAREPOINT_SITE_ID=
# optional capability (same as above)
HC_SHAREPOINT_DRIVE_ID=
# optional capability (CV root folder identity)
HC_CV_ROOT_ITEM_ID=
# optional capability (diagnostic only, never used to resolve paths at runtime)
HC_CV_ROOT_PATH=
# optional capability (governed catalog workbook identity; lives in the SAME
# drive as HC_SHAREPOINT_DRIVE_ID above -- never add a second drive variable)
HC_CATALOG_ITEM_ID=
# optional capability (additional Graph scope for document uploads; not a secret)
HC_DOCUMENT_WRITE_SCOPE=

# =============================================================================
# Commercial
# =============================================================================

# optional capability (workspace access gate)
COMMERCIAL_ALLOWED_USERS=
# optional capability (Commercial Strategy edit authorization)
CONTENT_OWNER=
# optional capability (Odoo CRM integration, read-only)
ODOO_URL=
# optional capability (same as above)
ODOO_DB=
# optional capability (same as above)
ODOO_USERNAME=
# optional capability (same as above). # SECRET
ODOO_API_KEY=

# required in deployment (safe local default)
DANWOR_COMMERCIAL_APP_TITLE=Gestión Comercial · CRM Danwor
# required in deployment (safe local default)
DANWOR_COMMERCIAL_APP_SUBTITLE=Gestión y analítica comercial | Danwor Transversal

# =============================================================================
# Operations / Reporting (Staffing + SharePoint Cases/Catalog/Security)
# =============================================================================

# optional capability (workspace access gate)
OPERATIONS_ALLOWED_USERS=
# optional capability (Staffing site identity; no default, Staffing fails
# explicit without it -- never breaks the rest of the Hub)
SHAREPOINT_GESTION_SITE_ID=
# optional capability (Staffing field mapping; no default by design -- only
# Staffing itself fails explicit if you try to read it without these)
SHAREPOINT_ASIGNACIONES_FIELD_COLABORADOR_LOOKUP=
SHAREPOINT_ASIGNACIONES_FIELD_PROYECTO_LOOKUP=
SHAREPOINT_ASIGNACIONES_FIELD_ALLOCATION=
SHAREPOINT_ASIGNACIONES_FIELD_STATUS=
SHAREPOINT_ASIGNACIONES_FIELD_START_DATE=
SHAREPOINT_ASIGNACIONES_FIELD_END_DATE=
SHAREPOINT_PROYECTOS_FIELD_TITLE=
SHAREPOINT_COLABORADORES_FIELD_TITLE=
# optional capability (Staffing enrichment fields; absence degrades to "Sin
# dato", never blocks Staffing)
SHAREPOINT_COLABORADORES_FIELD_DISPONIBILIDAD=
SHAREPOINT_PROYECTOS_FIELD_EMPRESA_LOOKUP=
SHAREPOINT_CLIENTE_FIELD_TITLE=

# required in deployment (safe local default)
DANWOR_OPERATIONS_APP_TITLE=Gestión Inteligente · Operaciones
# required in deployment (safe local default)
DANWOR_OPERATIONS_APP_SUBTITLE=Analítica y gestión operativa | Danwor Transversal
# required in deployment (safe local default)
SHAREPOINT_CASES_ENABLED=ON
# required in deployment (safe local default)
SHAREPOINT_CASES_SITE_ID=danwor.sharepoint.com,87f47e3b-f792-4537-bcac-8a26d5488789,616ef0c6-fda4-427e-92fb-5f8470732185
# required in deployment (safe local default)
SHAREPOINT_CASES_LIST_ID=973e8de0-35e2-4ba1-950b-34eaf88348fd
# required in deployment (safe local default)
SHAREPOINT_CASES_TOP_K=5
# required in deployment (safe local default)
SHAREPOINT_CASES_MIN_SCORE=6
# required in deployment (safe local default)
SHAREPOINT_CASES_CACHE_TTL=300
# required in deployment (safe local default -- PILOTO, no productivo)
SHAREPOINT_CATALOG_CSN_URL=https://danwor.sharepoint.com/:f:/s/PrcticaAnalytics/IgDMABujBXLDSIAVxSj6GI9LAdb4FvQjQckGYhQvuc-tIIg?e=PEazSD
# required in deployment (safe local default)
SHAREPOINT_SECURITY_ROLE_MATRIX_URL=https://danwor.sharepoint.com/:x:/s/PrcticaAnalytics/IQC_KaECHiU5TrOjJBpDhkC7AeH7NJUQhq3AACTGOSpltG8?e=n6CNhy
# required in deployment (safe local default)
SHAREPOINT_SECURITY_ROLE_MATRIX_CLIENT=Danone
# optional capability (link de compartir del libro Excel PRIVADO de perfiles Datasphere por cliente; solo dueño; vacio = sin selector, formulario manual)
SHAREPOINT_DSP_OAUTH_URL=
# required in deployment (safe local default -- known from legacy source,
# not yet live-Graph-validated)
SHAREPOINT_ASIGNACIONES_LIST_ID=c7c96b06-b32d-4386-8228-dd8e1f9926b0
SHAREPOINT_PROYECTOS_LIST_ID=efa2e279-593e-4321-867f-1ff982d800f6
SHAREPOINT_COLABORADORES_LIST_ID=6e512cd3-394a-461f-abcd-6613f2c21113
SHAREPOINT_HORAS_PROYECTOS_LIST_ID=6c3a8689-e7ed-4a2c-b358-10c5ca1b37b8
# required in deployment (safe local default -- live-Graph-validated)
SHAREPOINT_CLIENTE_LIST_ID=9c09571c-4fb8-4841-8f0d-4def03b3130d
SHAREPOINT_USER_INFORMATION_LIST_ID=72120868-9ce9-4e08-bf04-e7a62a71a3ab
# optional capability (cache EFIMERA del Assessment AD-HOC; vacio = <repo>/assessment_cache; NUNCA bajo un directorio persistido/espejado)
DANWOR_ASSESSMENT_CACHE_DIR=
# optional capability (almacen DURABLE del Assessment gobernado del Catalogo; vacio = <repo>/governed-assessments; registrado en SPACES_PERSIST_PATHS, que si esta definido en el entorno debe incluir 'governed-assessments')
DANWOR_GOVERNED_ASSESSMENTS_DIR=
